NODE_ENV=development
PORT=4000

# Supabase Postgres connection string (Session pooler recommended for migrations,
# Transaction pooler for the running app — see Supabase project settings > Database).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-random-32+-char-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32+-char-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

# Email — optional in development. If left unset, outgoing notification
# emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ICT Inventory System <noreply@university.ac.ke>"
